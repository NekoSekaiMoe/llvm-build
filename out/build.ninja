  COMMAND = cd /home/user/llvm-google/llvm/out/tools/llvm-rc && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="llvm-windres" -P /home/user/llvm-google/llvm/out/cmake_install.cmake
  pool = console


