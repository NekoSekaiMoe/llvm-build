re tools/clang/lib/Tooling/Inclusions/obj.clangToolingInclusions utils/TableGen/Basic/obj.LLVMTableGenBasic utils/TableGen/Common/obj.LLVMTableGenCommon
  COMMAND = cd /home/user/llvm-google/llvm/out/tools/clang && /home/user/llvm-google/llvm/out/bin/llvm-bolt /home/user/llvm-google/llvm/out/./bin/clang -o /home/user/llvm-google/llvm/out/tools/clang/clang.bolt -data /home/user/llvm-google/llvm/out/tools/clang/utils/perf-training/prof.fdata -reorder-blocks=ext-tsp -reorder-functions=hfsort+ -split-functions -split-all-cold -split-eh -dyno-stats -icf=1 -use-gnu-stack && /usr/bin/cmake -E rename /home/user/llvm-google/llvm/out/tools/clang/clang.bolt /home/user/llvm-google/llvm/out/bin/clang-20
  DESC = Optimizing Clang with BOLT
  restat = 1

# =============================================================================
# Write statements declared in CMakeLists.txt:
# /home/user/llvm-google/clang/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for EXECUTABLE target clang-tblgen


#############################################
# Order-only phony target for clang-tblgen

build cmake_object_order_depends_target_clang-tblgen: phony || cmake_object_order_depends_target_LLVMDemangle cmake_object_order_depends_target_LLVMSupport cmake_object_order_depends_target_LLVMTableGen cmake_object_order_depends_target_obj.clangSupport

build tools/clang/utils/TableGen/CMakeFiles/clang-tblgen.dir/ASTTableGen.cpp.o: CXX_COMPILER__clang-tblgen_unscanned_Release /home/user/llvm-google/clang/utils/TableGen/ASTTableGen.cpp || cmake_object_order_depends_target_clang-tblgen
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
