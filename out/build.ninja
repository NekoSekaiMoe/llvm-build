build lib/libclangExtractAPI.a: CXX_STATIC_LIBRARY_LINKER__clangExtractAPI_Release tools/clang/lib/ExtractAPI/CMakeFiles/obj.clangExtractAPI.dir/API.cpp.o tools/clang/lib/ExtractAPI/CMakeFiles/obj.clangExtractAPI.dir/APIIgnoresList.cpp.o tools/clang/lib/ExtractAPI/CMakeFiles/obj.clangExtractAPI.dir/ExtractAPIConsumer.cpp.o tools/clang/lib/ExtractAPI/CMakeFiles/obj.clangExtractAPI.dir/DeclarationFragments.cpp.o tools/clang/lib/ExtractAPI/CMakeFiles/obj.clangExtractAPI.dir/Serialization/SymbolGraphSerializer.cpp.o tools/clang/lib/ExtractAPI/CMakeFiles/obj.clangExtractAPI.dir/TypedefUnderlyingTypeResolver.cpp.o || lib/libLLVMAggressiveInstCombine.a lib/libLLVMAnalysis.a lib/libLLVMAsmParser.a lib/libLLVMBinaryFormat.a lib/libLLVMBitReader.a lib/libLLVMBitstreamReader.a lib/libLLVMCore.a lib/libLLVMDebugInfoBTF.a lib/libLLVMDebugInfoCodeView.a lib/libLLVMDebugInfoDWARF.a lib/libLLVMDebugInfoMSF.a lib/libLLVMDebugInfoPDB.a lib/libLLVMDemangle.a lib/libLLVMFrontendHLSL.a lib/libLLVMFrontendOffloading.a lib/libLLVMFrontendOpenMP.a lib/libLLVMIRReader.a lib/libLLVMInstCombine.a lib/libLLVMMC.a lib/libLLVMMCParser.a lib/libLLVMObject.a lib/libLLVMOption.a lib/libLLVMProfileData.a lib/libLLVMRemarks.a lib/libLLVMScalarOpts.a lib/libLLVMSupport.a lib/libLLVMSymbolize.a lib/libLLVMTargetParser.a lib/libLLVMTextAPI.a lib/libLLVMTextAPIBinaryReader.a lib/libLLVMTransformUtils.a lib/libLLVMWindowsDriver.a lib/libclangAPINotes.a lib/libclangAST.a lib/libclangASTMatchers.a lib/libclangAnalysis.a lib/libclangBasic.a lib/libclangDriver.a lib/libclangEdit.a lib/libclangFormat.a lib/libclangFrontend.a lib/libclangIndex.a lib/libclangInstallAPI.a lib/libclangLex.a lib/libclangParse.a lib/libclangRewrite.a lib/libclangSema.a lib/libclangSerialization.a lib/libclangSupport.a lib/libclangToolingCore.a lib/libclangToolingInclusions.a tools/clang/clang-tablegen-targets tools/clang/lib/ExtractAPI/obj.clangExtractAPI
