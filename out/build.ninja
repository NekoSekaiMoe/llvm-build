# Link the static library lib/libLLVMTargetParser.a

build lib/libLLVMTargetParser.a: CXX_STATIC_LIBRARY_LINKER__LLVMTargetParser_Release lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/AArch64TargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/ARMTargetParserCommon.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/ARMTargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/CSKYTargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/Host.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/LoongArchTargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/PPCTargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/RISCVISAInfo.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/RISCVTargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/SubtargetFeature.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/TargetParser.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/Triple.cpp.o lib/TargetParser/CMakeFiles/LLVMTargetParser.dir/X86TargetParser.cpp.o || include/llvm/TargetParser/AArch64TargetParserTableGen include/llvm/TargetParser/ARMTargetParserTableGen include/llvm/TargetParser/RISCVTargetParserTableGen lib/libLLVMDemangle.a lib/libLLVMSupport.a
  LANGUAGE_COMPILE_FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -O3 -DNDEBUG
  OBJECT_DIR = lib/TargetParser/CMakeFiles/LLVMTargetParser.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libLLVMTargetParser.a
  TARGET_PDB = LLVMTargetParser.a.dbg


#############################################
# Utility command for install-LLVMTargetParser

build lib/TargetParser/install-LLVMTargetParser: phony lib/TargetParser/CMakeFiles/install-LLVMTargetParser lib/libLLVMTargetParser.a


#############################################
# Utility command for install-LLVMTargetParser-stripped

build lib/TargetParser/install-LLVMTargetParser-stripped: phony lib/TargetParser/CMakeFiles/install-LLVMTargetParser-stripped lib/libLLVMTargetParser.a


#############################################
# Utility command for package

build lib/TargetParser/CMakeFiles/package.util: CUSTOM_COMMAND lib/TargetParser/all
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/TargetParser/package: phony lib/TargetParser/CMakeFiles/package.util


#############################################
