# Order-only phony target for obj.clangSema

build cmake_object_order_depends_target_obj.clangSema: phony || include/llvm/Frontend/OpenMP/omp_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions tools/clang/lib/Sema/ClangOpenCLBuiltinsImpl

build tools/clang/lib/Sema/CMakeFiles/obj.clangSema.dir/AnalysisBasedWarnings.cpp.o: CXX_COMPILER__obj.2eclangSema_unscanned_Release /home/user/llvm-google/clang/lib/Sema/AnalysisBasedWarnings.cpp || cmake_object_order_depends_target_obj.clangSema
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/Sema/CMakeFiles/obj.clangSema.dir/AnalysisBasedWarnings.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
