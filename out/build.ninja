#############################################
# Order-only phony target for LLVMDemangle

build cmake_object_order_depends_target_LLVMDemangle: phony || .

build lib/Demangle/CMakeFiles/LLVMDemangle.dir/Demangle.cpp.o: CXX_COMPILER__LLVMDemangle_unscanned_Release /home/user/llvm-google/llvm/lib/Demangle/Demangle.cpp || cmake_object_order_depends_target_LLVMDemangle
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = lib/Demangle/CMakeFiles/LLVMDemangle.dir/Demangle.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
  INCLUDES = -I/home/user/llvm-google/llvm/out/lib/Demangle -I/home/user/llvm-google/llvm/lib/Demangle -I/home/user/llvm-google/llvm/out/include -I/home/user/llvm-google/llvm/include
  OBJECT_DIR = lib/Demangle/CMakeFiles/LLVMDemangle.dir
  OBJECT_FILE_DIR = lib/Demangle/CMakeFiles/LLVMDemangle.dir

