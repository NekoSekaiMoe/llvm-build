#############################################
# Order-only phony target for obj.clangInterpreter

build cmake_object_order_depends_target_obj.clangInterpreter: phony || include/llvm/IR/intrinsics_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/Interpreter/CMakeFiles/obj.clangInterpreter.dir/DeviceOffload.cpp.o: CXX_COMPILER__obj.2eclangInterpreter_unscanned_Release /home/user/llvm-google/clang/lib/Interpreter/DeviceOffload.cpp || cmake_object_order_depends_target_obj.clangInterpreter
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/Interpreter/CMakeFiles/obj.clangInterpreter.dir/DeviceOffload.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
