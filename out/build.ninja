#############################################
# Order-only phony target for obj.clangToolingSyntax

build cmake_object_order_depends_target_obj.clangToolingSyntax: phony || include/llvm/Frontend/OpenMP/omp_gen tools/clang/clang-tablegen-targets

build tools/clang/lib/Tooling/Syntax/CMakeFiles/obj.clangToolingSyntax.dir/BuildTree.cpp.o: CXX_COMPILER__obj.2eclangToolingSyntax_unscanned_Release /home/user/llvm-google/clang/lib/Tooling/Syntax/BuildTree.cpp || cmake_object_order_depends_target_obj.clangToolingSyntax
