#############################################
# Order-only phony target for obj.clangFormat

build cmake_object_order_depends_target_obj.clangFormat: phony || tools/clang/clang-tablegen-targets

build tools/clang/lib/Format/CMakeFiles/obj.clangFormat.dir/AffectedRangeManager.cpp.o: CXX_COMPILER__obj.2eclangFormat_unscanned_Release /home/user/llvm-google/clang/lib/Format/AffectedRangeManager.cpp || cmake_object_order_depends_target_obj.clangFormat
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
