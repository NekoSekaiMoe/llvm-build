  OBJECT_DIR = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir
  OBJECT_FILE_DIR = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir

