build tools/lld/docs/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out/tools/lld/docs && /usr/bin/ccmake -S/home/user/llvm-google/llvm -B/home/user/llvm-google/llvm/out
