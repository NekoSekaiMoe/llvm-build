# Utility command for package

build tools/clang/lib/Parse/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/lib/Parse/all
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/lib/Parse/package: phony tools/clang/lib/Parse/CMakeFiles/package.util


