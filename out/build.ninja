  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/lld/docs/rebuild_cache: phony tools/lld/docs/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build tools/lld/docs/list_install_components: phony


#############################################
# Utility command for install

build tools/lld/docs/CMakeFiles/install.util: CUSTOM_COMMAND tools/lld/docs/all
  COMMAND = cd /home/user/llvm-google/llvm/out/tools/lld/docs && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build tools/lld/docs/install: phony tools/lld/docs/CMakeFiles/install.util


#############################################
