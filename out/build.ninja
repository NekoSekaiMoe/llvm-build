# =============================================================================
# Object build statements for OBJECT_LIBRARY target obj.clangDirectoryWatcher


#############################################
# Order-only phony target for obj.clangDirectoryWatcher

build cmake_object_order_depends_target_obj.clangDirectoryWatcher: phony || tools/clang/clang-tablegen-targets

build tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/DirectoryScanner.cpp.o: CXX_COMPILER__obj.2eclangDirectoryWatcher_unscanned_Release /home/user/llvm-google/clang/lib/DirectoryWatcher/DirectoryScanner.cpp || cmake_object_order_depends_target_obj.clangDirectoryWatcher
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/DirectoryScanner.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
  INCLUDES = -I/home/user/llvm-google/llvm/out/tools/clang/lib/DirectoryWatcher -I/home/user/llvm-google/clang/lib/DirectoryWatcher -I/home/user/llvm-google/clang/include -I/home/user/llvm-google/llvm/out/tools/clang/include -I/home/user/llvm-google/llvm/out/include -I/home/user/llvm-google/llvm/include
  OBJECT_DIR = tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir
  OBJECT_FILE_DIR = tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir

build tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/linux/DirectoryWatcher-linux.cpp.o: CXX_COMPILER__obj.2eclangDirectoryWatcher_unscanned_Release /home/user/llvm-google/clang/lib/DirectoryWatcher/linux/DirectoryWatcher-linux.cpp || cmake_object_order_depends_target_obj.clangDirectoryWatcher
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/linux/DirectoryWatcher-linux.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
  INCLUDES = -I/home/user/llvm-google/llvm/out/tools/clang/lib/DirectoryWatcher -I/home/user/llvm-google/clang/lib/DirectoryWatcher -I/home/user/llvm-google/clang/include -I/home/user/llvm-google/llvm/out/tools/clang/include -I/home/user/llvm-google/llvm/out/include -I/home/user/llvm-google/llvm/include
  OBJECT_DIR = tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir
  OBJECT_FILE_DIR = tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/linux



#############################################
# Object library obj.clangDirectoryWatcher

build tools/clang/lib/DirectoryWatcher/obj.clangDirectoryWatcher: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/DirectoryScanner.cpp.o tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/linux/DirectoryWatcher-linux.cpp.o

# =============================================================================
# Object build statements for STATIC_LIBRARY target clangDirectoryWatcher


#############################################
# Order-only phony target for clangDirectoryWatcher

build cmake_object_order_depends_target_clangDirectoryWatcher: phony || cmake_object_order_depends_target_LLVMDemangle cmake_object_order_depends_target_LLVMSupport cmake_object_order_depends_target_obj.clangDirectoryWatcher tools/clang/clang-tablegen-targets


# =============================================================================
# Link build statements for STATIC_LIBRARY target clangDirectoryWatcher


#############################################
# Link the static library lib/libclangDirectoryWatcher.a

build lib/libclangDirectoryWatcher.a: CXX_STATIC_LIBRARY_LINKER__clangDirectoryWatcher_Release tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/DirectoryScanner.cpp.o tools/clang/lib/DirectoryWatcher/CMakeFiles/obj.clangDirectoryWatcher.dir/linux/DirectoryWatcher-linux.cpp.o || lib/libLLVMDemangle.a lib/libLLVMSupport.a tools/clang/clang-tablegen-targets tools/clang/lib/DirectoryWatcher/obj.clangDirectoryWatcher
  LANGUAGE_COMPILE_FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG
  OBJECT_DIR = tools/clang/lib/DirectoryWatcher/CMakeFiles/clangDirectoryWatcher.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libclangDirectoryWatcher.a
  TARGET_PDB = clangDirectoryWatcher.a.dbg


#############################################
# Utility command for install-clangDirectoryWatcher

build tools/clang/lib/DirectoryWatcher/install-clangDirectoryWatcher: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/install-clangDirectoryWatcher lib/libclangDirectoryWatcher.a


#############################################
# Utility command for install-clangDirectoryWatcher-stripped

build tools/clang/lib/DirectoryWatcher/install-clangDirectoryWatcher-stripped: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/install-clangDirectoryWatcher-stripped lib/libclangDirectoryWatcher.a


#############################################
# Utility command for package

build tools/clang/lib/DirectoryWatcher/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/lib/DirectoryWatcher/all
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/lib/DirectoryWatcher/package: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/package.util


#############################################
# Utility command for package_source

build tools/clang/lib/DirectoryWatcher/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackSourceConfig.cmake /home/user/llvm-google/llvm/out/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build tools/clang/lib/DirectoryWatcher/package_source: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build tools/clang/lib/DirectoryWatcher/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out/tools/clang/lib/DirectoryWatcher && /usr/bin/ccmake -S/home/user/llvm-google/llvm -B/home/user/llvm-google/llvm/out
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build tools/clang/lib/DirectoryWatcher/edit_cache: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tools/clang/lib/DirectoryWatcher/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out/tools/clang/lib/DirectoryWatcher && /usr/bin/cmake --regenerate-during-build -S/home/user/llvm-google/llvm -B/home/user/llvm-google/llvm/out
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/clang/lib/DirectoryWatcher/rebuild_cache: phony tools/clang/lib/DirectoryWatcher/CMakeFiles/rebuild_cache.util


#############################################
