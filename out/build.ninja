build tools/clang/lib/CrossTU/CMakeFiles/obj.clangCrossTU.dir/CrossTranslationUnit.cpp.o: CXX_COMPILER__obj.2eclangCrossTU_unscanned_Release /home/user/llvm-google/clang/lib/CrossTU/CrossTranslationUnit.cpp || cmake_object_order_depends_target_obj.clangCrossTU
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/CrossTU/CMakeFiles/obj.clangCrossTU.dir/CrossTranslationUnit.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
  INCLUDES = -I/home/user/llvm-google/llvm/out/tools/clang/lib/CrossTU -I/home/user/llvm-google/clang/lib/CrossTU -I/home/user/llvm-google/clang/include -I/home/user/llvm-google/llvm/out/tools/clang/include -I/home/user/llvm-google/llvm/out/include -I/home/user/llvm-google/llvm/include
  OBJECT_DIR = tools/clang/lib/CrossTU/CMakeFiles/obj.clangCrossTU.dir
  OBJECT_FILE_DIR = tools/clang/lib/CrossTU/CMakeFiles/obj.clangCrossTU.dir



