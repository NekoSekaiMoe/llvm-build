# Object build statements for OBJECT_LIBRARY target obj.clangCodeGen


#############################################
# Order-only phony target for obj.clangCodeGen

build cmake_object_order_depends_target_obj.clangCodeGen: phony || include/llvm/IR/intrinsics_gen include/llvm/TargetParser/AArch64TargetParserTableGen include/llvm/TargetParser/ARMTargetParserTableGen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir/ABIInfo.cpp.o: CXX_COMPILER__obj.2eclangCodeGen_unscanned_Release /home/user/llvm-google/clang/lib/CodeGen/ABIInfo.cpp || cmake_object_order_depends_target_obj.clangCodeGen
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir/ABIInfo.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
