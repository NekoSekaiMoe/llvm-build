  COMMAND = cd /home/user/llvm-google/llvm/out/lib/TargetParser && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/TargetParser/install: phony lib/TargetParser/CMakeFiles/install.util


