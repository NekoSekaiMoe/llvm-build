# =============================================================================
# Object build statements for OBJECT_LIBRARY target obj.clangDynamicASTMatchers


#############################################
# Order-only phony target for obj.clangDynamicASTMatchers

build cmake_object_order_depends_target_obj.clangDynamicASTMatchers: phony || include/llvm/Frontend/OpenMP/omp_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/ASTMatchers/Dynamic/CMakeFiles/obj.clangDynamicASTMatchers.dir/Diagnostics.cpp.o: CXX_COMPILER__obj.2eclangDynamicASTMatchers_unscanned_Release /home/user/llvm-google/clang/lib/ASTMatchers/Dynamic/Diagnostics.cpp || cmake_object_order_depends_target_obj.clangDynamicASTMatchers
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/ASTMatchers/Dynamic/CMakeFiles/obj.clangDynamicASTMatchers.dir/Diagnostics.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
  INCLUDES = -I/home/user/llvm-google/llvm/out/tools/clang/lib/ASTMatchers/Dynamic -I/home/user/llvm-google/clang/lib/ASTMatchers/Dynamic -I/home/user/llvm-google/clang/include -I/home/user/llvm-google/llvm/out/tools/clang/include -I/home/user/llvm-google/llvm/out/include -I/home/user/llvm-google/llvm/include
