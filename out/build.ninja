build tools/clang/lib/AST/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/lib/AST/all
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/lib/AST/package: phony tools/clang/lib/AST/CMakeFiles/package.util


#############################################
# Utility command for package_source

build tools/clang/lib/AST/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackSourceConfig.cmake /home/user/llvm-google/llvm/out/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build tools/clang/lib/AST/package_source: phony tools/clang/lib/AST/CMakeFiles/package_source.util


