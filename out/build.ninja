# Object build statements for OBJECT_LIBRARY target obj.clangToolingCore


#############################################
# Order-only phony target for obj.clangToolingCore

build cmake_object_order_depends_target_obj.clangToolingCore: phony || tools/clang/clang-tablegen-targets

build tools/clang/lib/Tooling/Core/CMakeFiles/obj.clangToolingCore.dir/Diagnostic.cpp.o: CXX_COMPILER__obj.2eclangToolingCore_unscanned_Release /home/user/llvm-google/clang/lib/Tooling/Core/Diagnostic.cpp || cmake_object_order_depends_target_obj.clangToolingCore
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/Tooling/Core/CMakeFiles/obj.clangToolingCore.dir/Diagnostic.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
