#############################################
# Order-only phony target for obj.clangARCMigrate

build cmake_object_order_depends_target_obj.clangARCMigrate: phony || include/llvm/Frontend/OpenMP/omp_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/ARCMigrate/CMakeFiles/obj.clangARCMigrate.dir/ARCMT.cpp.o: CXX_COMPILER__obj.2eclangARCMigrate_unscanned_Release /home/user/llvm-google/clang/lib/ARCMigrate/ARCMT.cpp || cmake_object_order_depends_target_obj.clangARCMigrate
  DEFINES = -DGTEST_HAS_RTTI=0 -DHAS_LOGF128 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/ARCMigrate/CMakeFiles/obj.clangARCMigrate.dir/ARCMT.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -w -fdiagnostics-color -ffunction-sections -fdata-sections -flto -fno-common -Woverloaded-virtual -fno-strict-aliasing -pedantic -Wno-long-long -O3 -DNDEBUG -std=c++17  -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-rtti
