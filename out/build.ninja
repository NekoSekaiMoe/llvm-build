#############################################
# Utility command for install-LLVMCodeGen

build lib/CodeGen/install-LLVMCodeGen: phony lib/CodeGen/CMakeFiles/install-LLVMCodeGen lib/libLLVMCodeGen.a


#############################################
# Utility command for install-LLVMCodeGen-stripped

build lib/CodeGen/install-LLVMCodeGen-stripped: phony lib/CodeGen/CMakeFiles/install-LLVMCodeGen-stripped lib/libLLVMCodeGen.a


#############################################
# Utility command for package

build lib/CodeGen/CMakeFiles/package.util: CUSTOM_COMMAND lib/CodeGen/all
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/CodeGen/package: phony lib/CodeGen/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/CodeGen/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out && /usr/bin/cpack --config ./CPackSourceConfig.cmake /home/user/llvm-google/llvm/out/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/CodeGen/package_source: phony lib/CodeGen/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/CodeGen/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out/lib/CodeGen && /usr/bin/ccmake -S/home/user/llvm-google/llvm -B/home/user/llvm-google/llvm/out
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build lib/CodeGen/edit_cache: phony lib/CodeGen/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/CodeGen/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/llvm-google/llvm/out/lib/CodeGen && /usr/bin/cmake --regenerate-during-build -S/home/user/llvm-google/llvm -B/home/user/llvm-google/llvm/out
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/CodeGen/rebuild_cache: phony lib/CodeGen/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/CodeGen/list_install_components: phony


#############################################
# Utility command for install

build lib/CodeGen/CMakeFiles/install.util: CUSTOM_COMMAND lib/CodeGen/all
  COMMAND = cd /home/user/llvm-google/llvm/out/lib/CodeGen && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/CodeGen/install: phony lib/CodeGen/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/CodeGen/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/CodeGen/all
  COMMAND = cd /home/user/llvm-google/llvm/out/lib/CodeGen && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/CodeGen/install/local: phony lib/CodeGen/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build lib/CodeGen/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/CodeGen/all
  COMMAND = cd /home/user/llvm-google/llvm/out/lib/CodeGen && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build lib/CodeGen/install/strip: phony lib/CodeGen/CMakeFiles/install/strip.util


#############################################
# Custom command for lib/CodeGen/CMakeFiles/install-LLVMCodeGen

